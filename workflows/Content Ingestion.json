        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"hook_type\": { \"type\": \"string\" },\n    \"structure\": { \"type\": \"string\" },\n    \"tone\": { \"type\": \"string\" },\n    \"formatting_notes\": { \"type\": \"string\" },\n    \"cta_type\": { \"type\": \"string\" },\n    \"anti_patterns\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  },\n  \"required\": [\"hook_type\", \"structure\", \"tone\", \"formatting_notes\", \"cta_type\", \"anti_patterns\"]\n}"
      },
